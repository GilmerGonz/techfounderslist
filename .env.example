# ─── Database (required for production persistence) ───────────────────────
# When unset, the app falls back to an in-memory store (DEV ONLY — data is lost
# on restart and is NOT shared across serverless instances).
DATABASE_URL="postgresql://user:password@localhost:5432/techfounderslist?schema=public"

# ─── PayPal (required for real payments) ──────────────────────────────────
# Without these, the checkout endpoint returns mode:"demo" (local simulation).
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
# "live" enables real money movement AND hard-disables the demo-claim endpoint.
# Use "sandbox" (or leave unset) for testing.
PAYPAL_MODE="sandbox"
# PayPal webhook id, used to verify PAYMENT.CAPTURE.COMPLETED signatures.
PAYPAL_WEBHOOK_ID=""

# ─── Ownership token signing ──────────────────────────────────────────────
# HMAC secret used to sign/verify the per-company ownership token returned at
# company creation. Generate a long random string.
POSITION_CLAIM_SECRET="change-me-to-a-long-random-string"

# ─── Rate limiting (optional, recommended for production) ─────────────────
# When set, rate limits use Upstash Redis instead of the in-memory store
# (the in-memory store does not work across Vercel's multiple instances).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ─── Domain verification ──────────────────────────────────────────────────
# The claim flow requires ownerEmail's domain to match the company URL's domain
# (audit §1). Set to "true" to relax this (e.g. for aggregators/testing).
ALLOW_DOMAIN_MISMATCH="false"
